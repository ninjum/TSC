+#ifndef _CEGUIStdRegexMatcher_h_
+#define _CEGUIStdRegexMatcher_h_
+
+#include "CEGUI/RegexMatcher.h"
+#include "CEGUI/String.h"
+#include <regex>
+
+// Start of CEGUI namespace section
+namespace CEGUI
+{
+/*!
+\brief
+    Implementation of RegexMatcher using std::regex.
+
+    It exists so that a build WITHOUT PCRE still has a matcher. Without one,
+    System::createRegexMatcher() returned 0, every Editbox came up with no
+    validator, and Editbox::setValidationString - which Spinner calls for each
+    of its four input modes - threw InvalidRequestException. A CEGUI built
+    without PCRE could therefore not show a Spinner at all: the application
+    aborted the moment one was created.
+
+    ECMAScript grammar, which is std::regex's default and is close enough to
+    PCRE for the patterns a validation string is: Spinner's own four are
+    "-?\\d*\\.?\\d*", "-?\\d*", "[0-9a-fA-F]*" and "[0-7]*".
+
+    ONE DIFFERENCE from PCRERegexMatcher, and it is deliberate: this never
+    returns MS_PARTIAL, because std::regex has no partial matching. A pattern
+    whose prefixes are themselves valid - every one above, since each is built
+    out of * quantifiers - is unaffected, as each intermediate string a person
+    types matches fully. For a pattern that does require a suffix, an
+    intermediate string reports MS_INVALID rather than MS_PARTIAL, which is a
+    keystroke refused rather than an application aborted.
+*/
+class StdRegexMatcher : public RegexMatcher
+{
+public:
+    StdRegexMatcher();
+    ~StdRegexMatcher();
+
+    // implement required interface
+    void setRegexString(const String& regex);
+    const String& getRegexString() const;
+    MatchState getMatchStateOfString(const String& str) const;
+
+private:
+    //! Copy of the regex string assigned.
+    String d_string;
+    //! The compiled regex.
+    std::regex d_regex;
+    //! Whether d_regex holds a usable expression.
+    bool d_compiled;
+};
+
+} // End of  CEGUI namespace section
+
+#endif  // end of guard _CEGUIStdRegexMatcher_h_
