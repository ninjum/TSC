     return CEGUI_NEW_AO PCRERegexMatcher();
 #else
-    return 0;
+    // Without PCRE this returned 0, and an Editbox with no validator THROWS
+    // from setValidationString - which every Spinner calls when it is created.
+    // A build without PCRE therefore produced a library whose spinners abort
+    // the application the moment they are shown. std::regex needs no external
+    // library at all, so there is now always a matcher.
+    return CEGUI_NEW_AO StdRegexMatcher();
 #endif
 }
 
